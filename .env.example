# Local development (PostgreSQL)
DATABASE_URL=postgres://localhost/homefix
# Disposable database for integration tests (migrated and seeded with db/reset.sh)
TEST_DATABASE_URL=postgres://localhost/homefix_test

# Model: any OpenAI-compatible endpoint. Defaults to Gemini.
GEMINI_API_KEY=
# For other providers: MODEL_API_KEY overrides GEMINI_API_KEY; MODEL_BASE_URL defaults to Gemini.
# MODEL_API_KEY=
# MODEL_BASE_URL=
# MODEL_NAME=gemini-3.5-flash-lite
MODEL_TEMPERATURE=0
# Requests per minute sent to the provider (Gemini free tier allows 15).
MODEL_RPM=12

# Public demo protection
# When set, pages and /api/chat require this code.
# DEMO_ACCESS_CODE=
# Messages per tenant per minute.
CHAT_MAX_PER_MINUTE=10

# Hosted database (Supabase). Session pooler for migrations, transaction pooler for the app.
# SUPABASE_SESSION_URL=
# SUPABASE_POOLER_URL=
